# Classifarr Image Embedding Service - companion service for Classifarr
# Copyright (C) 2024-2026 Classifarr Contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# CUDA variant — installs the pinned PyTorch CUDA 13.0 profile and uses the
# verified NVIDIA CUDA 13.0.3 base. See README for the explicit CUDA 12.6 profile.
#
# Prerequisites on the Docker host:
#   NVIDIA Container Toolkit — https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/
#
# Build standalone:
#   docker build -f Dockerfile.cuda -t classifarr-image-embedder:cuda .
#
# Run with GPU via Compose override (recommended):
#   docker compose -f docker-compose.yml -f docker-compose.cuda.yml up -d

# ── Build stage: install wheels (no CUDA toolkit needed — we use pre-built wheels) ──
ARG CUDA_BASE=nvidia/cuda:13.0.3-base-ubuntu24.04@sha256:7c7413a56200486f71f181cad9310f6fd31b6bb21816ade15fc9c1e1e927a5c1
FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

ARG TORCH_PROFILE=requirements-torch-cuda.txt
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu130
COPY ${TORCH_PROFILE} /tmp/requirements-torch.txt

# Select Torch from one official index, then constrain the PyPI installation so
# a newer shared requirement cannot silently replace the chosen backend wheel.
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /tmp/requirements-torch.txt \
        --index-url "${TORCH_INDEX}"

COPY requirements.txt /tmp/
RUN /opt/venv/bin/pip install -r /tmp/requirements.txt \
        -c /tmp/requirements-torch.txt \
    && /opt/venv/bin/pip check

# ── Runtime stage: minimal CUDA base, no build tools ──────────────────────
# Torch's wheel dependencies supply CUDA libraries and cuDNN. The host driver
# supplies libcuda through NVIDIA Container Toolkit; do not duplicate cuDNN here.
FROM ${CUDA_BASE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
# Store HuggingFace model cache inside the app dir where appuser has write access
ENV HF_HOME="/app/.cache"
# Tell the NVIDIA Container Toolkit which driver capabilities are needed.
# 'compute' = CUDA compute; 'utility' = nvidia-smi / device enumeration.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Runtime-only system libraries.
# libgl1 / libglib2.0-0 are required by Pillow for image I/O.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    libgl1 \
    libglib2.0-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY src ./src
COPY scripts/backend_probe.py scripts/smoke_backend.py scripts/production_model_probe.py ./scripts/
COPY scripts/capacity_metrics.py scripts/capacity_workload.py scripts/capacity_api.py scripts/capacity_probe.py ./scripts/

# CIS Docker Benchmark 4.1: do not run as root
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid 1001 --no-create-home --shell /sbin/nologin appuser \
    && mkdir -p /app/.cache \
    && chown -R appuser:appgroup /app/.cache
USER appuser

EXPOSE 8000

# Model load at startup can take longer on first run (download + GPU warm-up).
# start-period is extended to 90 s relative to the CPU Dockerfile's 60 s.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD python -m image_embedder.healthcheck

CMD ["python", "-m", "image_embedder.server"]
